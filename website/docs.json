{
  "$schema": "https://holocron.so/docs.json",
  "name": "zele",
  "description": "Email and calendar CLI for Gmail, Outlook, IMAP/SMTP, and Google Calendar. For you and your agents.",
  "colors": {
    "primary": "#2563eb",
    "light": "#2563eb",
    "dark": "#60a5fa"
  },
  "knownPaths": ["/api/*"],
