        { "anchor": "GitHub", "icon": "lucide:github", "href": "https://github.com/remorses/zele" },
        { "anchor": "Changelog", "icon": "lucide:newspaper", "href": "https://github.com/remorses/zele/releases" }
      ]
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/remorses/zele"
    }
